# Configuration Supabase.
# Si ces variables sont absentes, le site bascule automatiquement sur un
# backend local (localStorage du navigateur) — voir src/lib/localBackend/.
VITE_SUPABASE_PROJECT_ID=xxxx
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publique

# --- Analytics (facultatif mais recommandé) ---
# Google Analytics 4 : identifiant de mesure (format G-XXXXXXXXXX).
# Sans cette variable, aucun suivi n'est chargé.
VITE_GA_ID=
# Alternative respectueuse de la vie privée (sans cookies) : domaine Plausible.
# Ex. VITE_PLAUSIBLE_DOMAIN=prismagestion.site
VITE_PLAUSIBLE_DOMAIN=

# --- Notifications email (secrets côté Supabase, PAS ici) ---
# La fonction edge `send-email` (Resend) notifie chaque contact/devis/RDV.
# À configurer côté serveur, jamais dans le front :
#   supabase secrets set RESEND_API_KEY=... NOTIFY_EMAIL=...
